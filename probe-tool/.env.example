# Required: your Google AI Studio API key
GEMINI_API_KEY= AIza...

# Optional: override the default model (default: gemini-2.5-flash-lite)
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional: max LLM retries on invalid JSON responses (default: 3)
LLM_JSON_RETRIES= 1

# Optional: max probe attempts per goal before giving up (default: 5)
MAX_PROBE_ATTEMPTS= 1
